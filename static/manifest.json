{
  "name": "PLS TRAVELS - Fleet Management",
  "short_name": "PLS TRAVELS",
  "description": "Multi-city driver and fleet management system for Chennai and Bangalore operations. Manage drivers, vehicles, duties, and earnings with real-time tracking and comprehensive reporting.",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#0f172a",
  "theme_color": "#00d4ff",
  "orientation": "portrait",
  "scope": "/",
  "lang": "en",
  "dir": "ltr",
  "categories": ["business", "productivity", "transportation"],
  "shortcuts": [
    {
      "name": "Driver Dashboard",
      "short_name": "Dashboard",
      "description": "Access driver dashboard for duty management",
      "url": "/driver/dashboard",
      "icons": [
        {
          "src": "/static/icons/shortcut-dashboard.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Start Duty",
      "short_name": "Duty",
      "description": "Start your driving duty",
      "url": "/driver/duty",
      "icons": [
        {
          "src": "/static/icons/shortcut-duty.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Earnings",
      "short_name": "Earnings",
      "description": "View your earnings and payments",
      "url": "/driver/earnings",
      "icons": [
        {
          "src": "/static/icons/shortcut-earnings.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Admin Panel",
      "short_name": "Admin",
      "description": "Fleet management and administration",
      "url": "/admin/dashboard",
      "icons": [
        {
          "src": "/static/icons/shortcut-admin.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    }
  ],
  "icons": [
